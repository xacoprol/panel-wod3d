# Copia a .env y ajusta los valores

# Local: Postgres (Neon / Docker / Vercel Postgres). SQLite ya no es compatible con Vercel.
# Ejemplo Neon:
# DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/vexo?schema=public"

AUTH_SECRET="genera-un-secreto-largo-aleatorio"
AUTH_URL="http://localhost:3000"

CRON_SECRET="secreto-para-el-endpoint-cron"

SEED_EMAIL="admin@factura.local"
SEED_PASSWORD="admin123"
